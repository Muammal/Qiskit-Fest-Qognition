# =============================================================================
# .gitignore - Qognition
# =============================================================================

# --- Python Bytecode & Build Artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Pytest & Test Runner Caches ---
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.cache/

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Environment Variables, Secrets & IBM Hardware Credentials ---
.env
.env.local
*.env
*.pem
*.key
token.txt
ibm_account.json
qiskit-ibm.json

# --- Temporary & Scratch Files ---
scratch/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*~

# --- Heavy Artifacts & Generated Media ---
artifacts/
*.mp4
*.avi
*.mov
*.pt
*.pth
*.onnx
*.tfevents.*
_vizdoom.ini

# --- Skill, Planning, Roles, Tech Stack & Risk Markdown Files (Gitignored) ---
PLAN.md
*plan*.md
*PLAN*.md
*.plan
*skill*.md
*SKILL*.md
**/SKILL.md
skills/
.agents/

ROLES.md
*role*.md
*ROLE*.md
*roles*.md
*ROLES*.md

TECH_STACK.md
*tech_stack*.md
*TECH_STACK*.md
*techstack*.md
*TECHSTACK*.md

RISKS_AND_FAQ.md
*risk*.md
*RISK*.md
*risks*.md
*RISKS*.md

# Tracked on purpose: the project's original plans, kept for the record.
!/docs/archive/*.md

# --- Generated end-of-event reports ---
exports/reports/
exports/sims/

# --- Operating System & Editor Metadata ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
.gemini/
*.log

disaster_data/raw/
